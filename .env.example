# ============================================================
# 环境变量模板 —— 复制为 .env（已被 .gitignore 忽略）并填入真实值
# 严禁将真实账号、密码、密钥提交到仓库或写入任何 Java / 前端文件
# ============================================================

# --- 数据库连接（必填）---
# URL 可选，未设置时使用 application.properties 中的默认（本地 localhost）
DB_URL=jdbc:mysql://localhost:3306/contest_db?serverTimezone=Asia/Shanghai&connectionCollation=utf8mb4_unicode_ci
DB_USERNAME=root
DB_PASSWORD=change_me

# --- 初始化账号（可选）---
# 首次启动、对应账号不存在时使用；不设置则自动生成随机密码并打印到启动日志
INIT_SUPER_ADMIN_USERNAME=superadmin
INIT_SUPER_ADMIN_PASSWORD=change_me_strong
INIT_DEFAULT_ADMIN_PASSWORD=change_me_default

# ============================================================
# 使用方式：
#   1) 直接设置系统/IDE 环境变量（推荐生产）：
#        export DB_USERNAME=root DB_PASSWORD=xxxxx
#        ./mvnw spring-boot:run
#   2) 或在 IDEA 运行配置的 Environment variables 中逐项填入
#   3) 生产环境通过部署平台（systemd / 容器编排 / 面板）注入，勿落地文件
# ============================================================
